# Supabase Postgres — server-only. URL-encode special characters in the password (# → %23, @ → %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Optional MongoDB Atlas Connection URI
MONGODB_URI=
PORT=5001

# Search engine verification (paste the code from Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
